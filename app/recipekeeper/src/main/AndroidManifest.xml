<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Required on API 33+ to post the foreground-service notification that
        keeps the model download alive when the app is backgrounded.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Foreground-service permission (API 28+). Needed because
        ModelDownloadWorker calls setForeground().
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".app.RecipeKeeperApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LlmLocalAndroid"
        tools:targetApi="33">

        <!--
            OpenCL is optional. The MediaPipe LLM engine falls back to the CPU
            backend if no OpenCL is present. These declarations must be inside
            <application>, not at the manifest root.
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-car.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false" />

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LlmLocalAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            System share target. No UI: it parses the share, forwards it to
            MainActivity (singleTop) and finishes. This entry carries the filter
            that is always on: a text/plain share containing a link opens the
            in-app browser on it.
        -->
        <activity
            android:name=".app.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.RecipeKeeper.ShareReceiver">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Picture shares. Intent filters cannot be toggled by a manifest
            placeholder, a component can: this alias of ShareReceiverActivity is
            enabled only when IMAGES_SOURCE is on (build.gradle.kts feeds the same
            `imagesSource` value to BuildConfig.IMAGES_SOURCE and to
            ${imagesShareTarget}). Disabled, the system never resolves it, so an
            image share cannot reach the app and the share sheet does not list it.
        -->
        <activity-alias
            android:name=".app.ShareImagesAlias"
            android:targetActivity=".app.ShareReceiverActivity"
            android:enabled="${imagesShareTarget}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!--
            Disable WorkManager's default initializer so it uses our
            Configuration.Provider path (RecipeKeeperApp), which lets us inject a
            Koin-aware WorkerFactory.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Required on API 34+ (Android 14): WorkManager's own
            SystemForegroundService must be declared with a
            foregroundServiceType that matches the type ModelDownloadWorker
            requests when promoting itself to foreground via setForeground().
            Without this, the OS throws IllegalArgumentException at runtime:

                foregroundServiceType 0x00000001 is not a subset of
                foregroundServiceType attribute 0x00000000 in service element

            The library's own manifest entry isn't always merged into apps
            that disable WorkManager's default initializer, so declare it
            explicitly here. Keep this in sync with
            ModelDownloadWorker.foregroundInfo(...) (DATA_SYNC).
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />
    </application>

</manifest>