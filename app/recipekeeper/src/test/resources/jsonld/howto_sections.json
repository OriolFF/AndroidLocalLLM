{
  "@context": "https://schema.org/",
  "@type": ["Recipe", "NewsArticle"],
  "name": "Lasagne al forno",
  "image": [
    "https://cdn.example.com/lasagne-1x1.jpg",
    "https://cdn.example.com/lasagne-side.jpg",
    { "@type": "ImageObject", "contentUrl": "https://cdn.example.com/lasagne-slice.jpg" }
  ],
  "recipeYield": ["6", "6 servings"],
  "totalTime": "PT2H30M",
  "recipeIngredient": ["500 g beef mince", "1 onion, diced", "700 ml passata", "50 g butter", "50 g flour", "500 ml milk", "12 lasagne sheets"],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Ragù",
      "itemListElement": [
        { "@type": "HowToStep", "text": "Brown the mince with the onion." },
        { "@type": "HowToStep", "text": "Add the passata and simmer for 1 hour." }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Béchamel",
      "itemListElement": [
        { "@type": "HowToStep", "text": "Melt the butter, whisk in the flour, then the milk until thick." }
      ]
    },
    { "@type": "HowToStep", "text": "Layer and bake at 180°C for 40 minutes." }
  ]
}
